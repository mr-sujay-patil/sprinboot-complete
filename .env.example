# --- Shared Security Secrets ---
# WHY: Base64-encoded 256-bit+ key used symmetrically by auth-server (to sign tokens) and ai-service/task-service (to verify tokens).
#JWT_SECRET=YXV0aHNlcnZlcnNlY3JldGtleWZvcmF1dGhlbnRpY2F0aW9uamF2YWZ1bGxzdGFja3NlY3JldGtleQ==

# --- AI Service Credentials ---
# WHY: API Key for OpenRouter provider in ai-service. Externalized so secrets are never committed into git or container images.
#OPENROUTER_API_KEY=open-router-key

# WHY: API Key for OpenAI provider in ai-service (if active-provider is switched to 'openai').
#OPENAI_API_KEY=sk-proj-your-openai-key-here

# --- Service Discovery Configuration ---
# WHY: Container network URL pointing to Eureka Server by its container hostname 'eureka-server' instead of 'localhost'.
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
